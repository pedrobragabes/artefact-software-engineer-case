{
  "name": "artefact-software-engineer-case",
  "version": "1.0.0",
  "private": true,
  "description": "A minimal task management application built with Next.js 15, TypeScript, and tRPC.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/tasks.test.ts",
    "test:e2e": "playwright test"
  },
  "overrides": {
    "postcss": "8.5.32"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@trpc/client": "11.22.1",
    "@trpc/server": "11.22.1",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
